# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/aura_erp?schema=public"

# ---------------------------------------------------------------------------
# Authentication — generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Aura Laundry"

# ---------------------------------------------------------------------------
# Object storage — garment photos and complaint attachments
# STORAGE_DRIVER: local | s3 | r2 | supabase
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
STORAGE_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------------------
# Payments — PAYMENT_PROVIDER: manual | razorpay
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="manual"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
UPI_VPA=""
UPI_PAYEE_NAME=""

# ---------------------------------------------------------------------------
# Notifications
#
# There is no SMS integration: customer notices are raised in-app and read
# out or printed at the counter. Email is optional and stays switched off
# until both variables below are set. WhatsApp is a real integration — see
# the OpenWA Gateway section below — and works independently of email.
# ---------------------------------------------------------------------------
EMAIL_API_KEY=""
EMAIL_FROM="Aura Laundry <no-reply@example.com>"

# ---------------------------------------------------------------------------
# WhatsApp OpenWA Gateway
#
# Run the gateway with `npm run whatsapp:server` (scripts/openwa-server.mjs) —
# a real Baileys WhatsApp Web client wrapped in a small REST API, not a mock.
# These three variables are server-only; never prefix them with NEXT_PUBLIC_
# or they would ship the API key to the browser.
# ---------------------------------------------------------------------------
OPENWA_BASE_URL="http://localhost:8080"
OPENWA_API_KEY="aurclean_secret_key"
OPENWA_SESSION_ID="aurclean_session"


